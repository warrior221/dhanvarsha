# ---------------------------------------------------------------
# Template of every environment variable this app needs.
# Copy to .env.local and fill in real values. NEVER put real
# values in this file — it is committed to git.
# ---------------------------------------------------------------

# Database (Neon Postgres)
# DATABASE_URL  = pooled connection  (hostname contains -pooler), used by the app
# DIRECT_URL    = direct connection  (same host without -pooler), used by
#                 prisma migrate/studio/seed, which need session state that
#                 Neon's PgBouncer pooler does not provide.
DATABASE_URL=
DIRECT_URL=

# Auth — generate with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Images (ImageKit)
# Dashboard -> Developer options -> API keys. Only the private key is secret;
# the public key and URL endpoint are meant to be visible in the browser.
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
