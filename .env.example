# ---------------------------------------------------------------
# Template of every environment variable this app needs.
# Copy to .env.local and fill in real values. NEVER put real
# values in this file — it is committed to git.
# ---------------------------------------------------------------

# Database (Neon Postgres)
# DATABASE_URL  = pooled connection  (hostname contains -pooler), used by the app
# DIRECT_URL    = direct connection  (same host without -pooler), used by
#                 prisma migrate/studio/seed, which need session state that
#                 Neon's PgBouncer pooler does not provide.
DATABASE_URL=
DIRECT_URL=

# Auth — generate with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Images (ImageKit)
# Dashboard -> Developer options -> API keys. Only the private key is secret;
# the public key and URL endpoint are meant to be visible in the browser.
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp (Meta Cloud API) — for step 2 of the admin sign-in checks.
# All three are needed before the step runs; until then it is skipped.
# Requires a verified Meta Business account and a template approved by Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=

# Google reviews (Places API) — optional, for importing your Google reviews.
# Needs a Google Cloud project with the Places API enabled and billing on.
# Google returns at most FIVE reviews and chooses which five.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
