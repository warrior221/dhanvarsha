generator client {
  provider = "prisma-client-js"
  /// Generated inside src/ rather than into node_modules so the dev server
  /// WATCHES it. In node_modules a running `next dev` keeps the pre-migration
  /// client in memory, and the next query fails with "Unknown field …" while
  /// pointing the blame at your own page code. Here a regenerate is an
  /// ordinary file change and Turbopack reloads. The folder is generated, not
  /// written by hand, so it is gitignored and rebuilt by postinstall.
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The connection string for migrate /
// studio lives in prisma.config.ts; the runtime client connects via the
// driver adapter configured in src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  PREPAID
  COD
}

enum AttributeInputType {
  CHECKBOX
  SELECT
}

enum OtpChannel {
  EMAIL
  WHATSAPP
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  COD_CONFIRMATION
  PASSWORD_RESET
  /// A step in the admin sign-in ladder. Keyed to one session, not to a
  /// person, so a code issued for one browser cannot be used in another.
  ADMIN_MFA
}

model User {
  id              String               @id @default(cuid())
  name            String
  email           String               @unique
  passwordHash    String?
  role            Role                 @default(CUSTOMER)
  /// Unique so it can be a sign-in identifier in its own right. Null is
  /// allowed many times over; Postgres does not treat nulls as equal.
  phone           String?              @unique
  emailVerified   DateTime?
  /// A delivery cannot be arranged against a number nobody answers, so an
  /// order requires this to be set (spec 1.6 / section 7).
  phoneVerified   DateTime?
  twoFactorSecret String?
  addresses       Address[]
  cart            Cart?
  orders          Order[]
  wishlist        Wishlist[]
  reviews         Review[]
  shopReviews     ShopReview[]
  statusChanges   OrderStatusHistory[]
  stockMovements  StockMovement[]
  purchases       Purchase[]
  stocktakes      Stocktake[]
  supplierPhotoViews SupplierPhotoView[]
  sessions        Session[]
  adminMfa        AdminMfa?
  setupTokens     SetupToken[]
  createdAt       DateTime             @default(now())

  @@index([role])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  phone     String
  isDefault Boolean @default(false)
  /// Hidden from the address book but kept for order history. Order.addressId
  /// is a live relation, not a snapshot, so a row used by an order must never
  /// be edited in place or deleted - that would rewrite the delivery address
  /// on invoices already sent.
  isArchived Boolean @default(false)
  orders    Order[]

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  position Int       @default(0)
  /// Tile shown on the home page. Without one the card falls back to the
  /// newest product's photo, which leaves a brand-new category blank.
  imageUrl String?
  products Product[]
}

model Product {
  id               String                  @id @default(cuid())
  sku              String                  @unique
  name             String
  slug             String                  @unique
  description      String
  categoryId       String
  category         Category                @relation(fields: [categoryId], references: [id])

  /// Optional. The "was" price, struck through on the shop. Without one the
  /// selling price shows alone, with no strikethrough and no discount badge.
  mrp              Decimal?                @db.Decimal(10, 2)
  /// Optional, because a piece is entered when it arrives from the weaver and
  /// priced later. A piece with no selling price is INVISIBLE to customers —
  /// it sits in the database waiting for the admin to price it, and pricing it
  /// is what puts it on the shop.
  sellingPrice     Decimal?                @db.Decimal(10, 2)

  isReadymade      Boolean                 @default(false)
  careInstructions String?
  isActive         Boolean                 @default(true)
  /// Silk Mark hologram number, when this piece carries one. Set per piece,
  /// never derived from the fabric: the Silk Mark Organisation certifies an
  /// individual saree with a numbered tag, so "made of silk" is not the same
  /// claim as "Silk Mark certified".
  silkMarkNumber   String?

  cost             ProductCost?
  attributes       ProductAttributeValue[]
  images           ProductImage[]
  variants         ProductVariant[]
  wishlistedBy     Wishlist[]
  reviews          Review[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([categoryId, isActive])
  @@index([sellingPrice])
  @@index([isReadymade])
  @@index([createdAt])
}

// ADMIN ONLY. Separate table so a customer-facing findMany() cannot leak it.
model ProductCost {
  id           String   @id @default(cuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  costPrice    Decimal  @db.Decimal(10, 2)
  /// The old free-text name. Kept until every row has been matched to a
  /// Supplier and the owner has confirmed the groupings — never merged
  /// silently, because "Ramesh" and "Ramesh Weavers" may be two people.
  supplierName String?
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseNote String?
  updatedAt    DateTime @updatedAt
}

model Attribute {
  id           String             @id @default(cuid())
  name         String             @unique
  slug         String             @unique
  inputType    AttributeInputType @default(CHECKBOX)
  isFilterable Boolean            @default(true)
  isRequired   Boolean            @default(false)
  position     Int                @default(0)
  values       AttributeValue[]
}

model AttributeValue {
  id          String                  @id @default(cuid())
  attributeId String
  attribute   Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  slug        String
  position    Int                     @default(0)
  products    ProductAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId])
}

model ProductAttributeValue {
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  valueId   String
  value     AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productId, valueId])
  @@index([valueId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  altText   String
  position  Int

  @@index([productId])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String?
  sku        String      @unique
  /// Optional, and this is the price actually charged — Product.sellingPrice
  /// is what the shop displays. A variant with no price cannot be bought:
  /// cart and checkout refuse it, and its product is hidden from customers.
  price      Decimal?    @db.Decimal(10, 2)
  stockQty   Int         @default(0)
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  StockMovement[]
  purchaseItems PurchaseItem[]
  stocktakeLines StocktakeLine[]
  /// Code 128, printed on the tag and scanned at the counter. Unique across
  /// the shop. Null only for variants created before barcodes existed.
  barcode    String?     @unique

  @@index([productId])
}

// userId OR sessionId is set - never both, never neither.
model Wishlist {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([sessionId, productId])
  @@index([sessionId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id             String               @id @default(cuid())
  orderNumber    String               @unique
  userId         String
  user           User                 @relation(fields: [userId], references: [id])
  addressId      String
  address        Address              @relation(fields: [addressId], references: [id])
  status         OrderStatus          @default(PENDING)
  paymentMethod  PaymentMethod

  subtotal       Decimal              @db.Decimal(10, 2)
  shippingCharge Decimal              @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal              @default(0) @db.Decimal(10, 2)
  total          Decimal              @db.Decimal(10, 2)

  courierName    String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  items          OrderItem[]
  payment        Payment?
  statusHistory  OrderStatusHistory[]
  stockMovements StockMovement[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  productName  String
  productImage String
  size         String?
  price        Decimal        @db.Decimal(10, 2)
  costPrice    Decimal        @db.Decimal(10, 2)
  quantity     Int

  @@index([orderId])
}

// Only for PREPAID orders. COD orders have no Payment row.
model Payment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id])
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  status            String
  amount            Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Idempotency guard for Razorpay webhook retries.
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  changedBy   User?        @relation(fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  identifier String
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([identifier, purpose, createdAt])
  @@index([expiresAt])
}

model SetupToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  /// When the admin second-factor ladder was last completed on THIS session.
  /// Null means an admin signed in with a password but has not yet passed the
  /// extra checks, so /admin stays closed to them.
  mfaVerifiedAt DateTime?
  mfaChallenge  AdminMfaChallenge?

  @@index([userId])
}

/// Tiered delivery charges, configurable from the admin rather than hardcoded
/// (spec 1.1: shipping rules live in the database, never in code).
///
/// The rule applied is the one with the HIGHEST minSubtotal that the order's
/// subtotal reaches, so "free over 2000" simply beats "99 from 0".
model ShippingRule {
  id             String   @id @default(cuid())
  name           String
  /// Applies when the order subtotal is at or above this amount.
  minSubtotal    Decimal  @db.Decimal(10, 2)
  charge         Decimal  @db.Decimal(10, 2)
  /// Added on top for cash on delivery, where a handling fee is common.
  codExtraCharge Decimal  @default(0) @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@index([isActive, minSubtotal])
}

/// Shop-wide settings. Exactly one row, id "store", created on first save.
///
/// Tax lives here rather than in code because the GST rate on textiles has
/// changed before and will change again — the shop owner must be able to
/// correct it without a developer.
model StoreSetting {
  id               String   @id @default("store")
  /// GST percentage applied to the goods subtotal, e.g. 5.00.
  gstRate          Decimal  @default(0) @db.Decimal(5, 2)
  /// True when the displayed price already contains GST, which is how Indian
  /// retail normally quotes. False adds it on top at checkout.
  pricesIncludeTax Boolean  @default(true)
  /// Printed on invoices once the business is registered.
  gstin            String?
  legalName        String?
  updatedAt        DateTime @updatedAt
}

/// Cached India Post lookups, so a PIN code is fetched from the outside world
/// once and served from our own database forever after.
///
/// This is a cache, not a source of truth: a row can be deleted safely and
/// will simply be fetched again.
model PincodeArea {
  pincode   String   @id
  city      String
  /// Already normalised to one of INDIAN_STATES.
  state     String
  /// Post office / locality names, offered as suggestions for the area field.
  areas     String[]
  fetchedAt DateTime @default(now())
}


/// Admin second-factor enrolment. One row per admin who has set it up.
///
/// Customers never have one: a customer account cannot see cost prices, and
/// forcing three checks on a shopper would cost far more in lost sales than
/// it protects.
model AdminMfa {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Base32 TOTP secret for the authenticator app.
  totpSecret     String?
  /// Set once the admin has proved the app is working by entering a code.
  totpConfirmedAt DateTime?

  /// 10-digit Indian mobile for the WhatsApp step.
  whatsappPhone      String?
  whatsappVerifiedAt DateTime?

  recoveryCodes AdminRecoveryCode[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

/// Single-use codes that stand in for the whole ladder when a phone is lost.
/// Stored bcrypt-hashed, exactly like a password.
model AdminRecoveryCode {
  id       String    @id @default(cuid())
  mfaId    String
  mfa      AdminMfa  @relation(fields: [mfaId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([mfaId, usedAt])
}

/// Progress through the three steps, for one session, while it is happening.
/// Deleted once the ladder is complete or when it expires.
model AdminMfaChallenge {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  emailAt      DateTime?
  whatsappAt   DateTime?
  totpAt       DateTime?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

enum ShopReviewSource {
  /// Written on this website.
  WEBSITE
  /// Pulled from the shop's Google Business listing.
  GOOGLE
}

/// A review of the SHOP, not of one product.
///
/// Shown as a moving strip on the home page. Website reviews stay hidden
/// until an admin approves them: the home page is the first thing a stranger
/// sees, and an open text box wired straight to it is an invitation.
model ShopReview {
  id          String           @id @default(cuid())
  source      ShopReviewSource @default(WEBSITE)
  authorName  String
  /// 1 to 5. Checked in code as well as here.
  rating      Int
  body        String
  isPublished Boolean          @default(false)
  /// Google's own id for the review, so re-importing updates rather than
  /// duplicates. Null for reviews written here.
  externalId  String?          @unique
  /// Google supplies a profile photo and a link; both must be shown when
  /// their reviews are displayed.
  authorPhotoUrl String?
  authorUrl      String?
  /// When the customer wrote it, which is not when we imported it.
  reviewedAt  DateTime
  /// Set when a signed-in customer wrote it, so the shop can see who.
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isPublished, reviewedAt])
}

/// Why stock moved. Every movement has exactly one reason.
enum StockReason {
  /// Already on the shelf when the system started counting.
  OPENING_BALANCE
  /// Bought in from a weaver or seller. (Phase 2.)
  PURCHASE
  /// Sold through the website.
  ONLINE_SALE
  /// An online order cancelled before dispatch, putting the piece back.
  ONLINE_CANCEL
  /// An online order returned, putting the piece back.
  ONLINE_RETURN
  /// Scanned out at the counter when the piece left the shop. (Phase 4.)
  SHOP_CHECKOUT
  /// An admin undoing a counter scan. Points at the original movement.
  SHOP_CHECKOUT_UNDO
  /// A correction applied after a shelf count. (Phase 5.)
  STOCKTAKE
  /// Damaged, spoiled or otherwise written off.
  DAMAGE
  /// Anything else. Always with a note.
  ADJUSTMENT
}

/// A single change to one variant's stock.
///
/// THE SHOP'S PERMANENT IN-AND-OUT HISTORY. `ProductVariant.stockQty` is a
/// cached balance and must always equal the sum of that variant's deltas. A
/// bare number cannot answer "where did this saree go?", which is the whole
/// reason this table exists.
///
/// Rows are never edited or deleted. A mistake is corrected by a NEW movement
/// pointing at the original through `reversesMovement`.
///
/// `purchaseId` and `stocktakeId` from the plan are deliberately absent until
/// Purchase (Phase 2) and Stocktake (Phase 5) exist — a nullable string with
/// no foreign key behind it is worse than no column at all.
model StockMovement {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Signed: positive came in, negative went out. Never zero.
  delta        Int
  /// The variant's stockQty immediately after this movement, so the history
  /// reads without re-adding every row before it.
  balanceAfter Int
  reason       StockReason
  /// Set when the movement came from an online order.
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Set on a correcting movement, pointing at the one it reverses. Unique, so
  /// the same movement cannot be reversed twice.
  reversesMovementId String?        @unique
  reversesMovement   StockMovement? @relation("StockReversal", fields: [reversesMovementId], references: [id], onDelete: SetNull)
  reversedBy         StockMovement? @relation("StockReversal")
  /// Set when a shelf count produced this correction. Unique, so the same
  /// difference cannot be corrected twice.
  stocktakeLineId    String?        @unique
  stocktakeLine      StocktakeLine? @relation(fields: [stocktakeLineId], references: [id], onDelete: SetNull)
  /// Required for DAMAGE and ADJUSTMENT, where the number alone explains
  /// nothing. Enforced in code.
  note         String?
  /// Null when the shop itself moved the stock — an order, or a webhook.
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([variantId, createdAt])
  @@index([reason, createdAt])
}

/// A weaver or seller the shop buys from.
///
/// A RECORD, not a typed name. Free text turns "Ramesh Weavers", "Ramesh
/// weavers" and "Ramesh" into three suppliers in any report, and has nowhere
/// to keep a phone number.
///
/// Never deleted once it has purchases — deactivated instead, so old purchase
/// records keep naming who supplied the goods.
model Supplier {
  id        String  @id @default(cuid())
  name      String
  /// Unique so a weaver cannot be added twice. Optional only because
  /// suppliers migrated from the old free-text field may not have one yet.
  mobile    String? @unique
  notes     String?
  isActive  Boolean @default(true)
  /// One optional photo, held IN THE DATABASE rather than on an image host.
  ///
  /// The shop may use it for the weaver's face or for an identity document;
  /// nothing is read from it, verified, or extracted, and no Aadhaar number is
  /// ever stored as text.
  ///
  /// In the database on purpose. An image host serves files by URL, and a URL
  /// that exists can be shared, guessed or cached — "not linked from the site"
  /// is not the same as private. Here there is no URL at all: the bytes come
  /// out only through an admin-guarded route, and every viewing is recorded.
  ///
  /// Neon encrypts at rest; the protection that matters is the guard on the
  /// route.
  photo         Bytes?
  /// A small square crop, shown as the face of the weaver's card.
  ///
  /// Kept separately so a list of cards never loads the full image. It is also
  /// too small for the text on a photo ID to be read, which is the point: the
  /// card shows you WHO, and the readable original stays behind a deliberate
  /// press that gets logged.
  photoThumb    Bytes?
  photoMimeType String?
  /// Set whenever a photo is stored, cleared when it is removed. Lets a list
  /// ask "is there a photo?" without ever loading the bytes.
  photoUpdatedAt DateTime?

  purchases   Purchase[]
  costs       ProductCost[]
  photoViews  SupplierPhotoView[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

/// Every time an admin opened a supplier's photo.
///
/// The photo may be an identity document, so looking at one is recorded. Not
/// to police the shop, but so "who has seen this" has an answer.
model SupplierPhotoView {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  viewedById String
  viewedBy   User     @relation(fields: [viewedById], references: [id], onDelete: Cascade)
  viewedAt   DateTime @default(now())

  @@index([supplierId, viewedAt])
}

/// One delivery from one supplier.
model Purchase {
  id             String         @id @default(cuid())
  /// Human-facing, P-00001 upwards.
  purchaseNumber String         @unique
  /// Optional: opening stock already in the shop has no delivery behind it.
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseDate   DateTime       @default(now())
  note           String?
  items          PurchaseItem[]
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([supplierId, purchaseDate])
  @@index([purchaseDate])
}

/// One line of a delivery: this many of this piece, at this cost.
///
/// `unitCost` is a SNAPSHOT of what that batch cost. The product's current
/// cost may move on afterwards — a restock averages it — but what was paid on
/// the day never changes.
model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  unitCost   Decimal        @db.Decimal(10, 2)

  @@index([purchaseId])
  @@index([variantId])
}

/// Where a shelf count stands.
enum StocktakeStatus {
  /// Scanning the shelves. Counts may still change.
  OPEN
  /// Scanning finished and the expected figures are frozen. The report can be
  /// read and corrections applied.
  COUNTED
  /// Every difference has been either applied or left alone. Read-only.
  CLOSED
  /// Given up on. Nothing was applied and nothing ever will be.
  ABANDONED
}

/// One shelf count: scan everything on the shelves, then compare.
///
/// The safety net for pieces that left the shop without being scanned out. The
/// website goes on believing those are in stock and may sell them online a
/// second time; a count is the only thing that finds them.
///
/// NOTHING IS EVER APPLIED AUTOMATICALLY. A count produces a report; the owner
/// decides line by line what to correct, and each correction is an ordinary
/// STOCKTAKE movement in the same ledger as everything else.
model Stocktake {
  id          String          @id @default(cuid())
  status      StocktakeStatus @default(OPEN)
  /// What this count was for, in the owner's own words.
  note        String?
  lines       StocktakeLine[]
  startedById String?
  startedBy   User?           @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedAt   DateTime        @default(now())
  /// When scanning stopped and `StocktakeLine.expectedQty` was frozen.
  countedAt   DateTime?
  closedAt    DateTime?

  @@index([status, startedAt])
  @@index([startedAt])
}

/// One piece in a count: how many were found, how many were expected.
///
/// Created as the shelves are scanned, and once more at the end for everything
/// the system expected but nobody scanned — those are the missing pieces, and
/// they are the entire point of counting.
///
/// `expectedQty` is FROZEN when scanning stops, not read at the moment a
/// correction is applied. Time passes between counting and correcting, and an
/// online order in that gap would otherwise be silently undone. Applying
/// checks the live figure against this one and refuses the line if it has
/// moved, rather than guessing.
model StocktakeLine {
  id          String         @id @default(cuid())
  stocktakeId String
  stocktake   Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  /// Null only when a scanned tag belonged to no piece in the system.
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// The tag as scanned, kept even when it matched nothing so an unreadable or
  /// foreign label can still be looked at afterwards. Null on a line raised at
  /// the end for a piece nobody scanned.
  scannedCode String?
  /// How many were actually found on the shelf. One per scan of the tag.
  countedQty  Int            @default(0)
  /// What the system believed was in stock when scanning stopped. Null while
  /// the count is still open.
  expectedQty Int?
  /// Set when the owner decides this difference needs no correction.
  skippedAt   DateTime?
  /// The correction, if one was applied. Null means nothing was changed.
  appliedMovement StockMovement?
  firstSeenAt DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// One line per piece per count, so scanning the same tag again adds to the
  /// count instead of making a second row.
  @@unique([stocktakeId, variantId])
  /// The same for a tag that matched nothing.
  @@unique([stocktakeId, scannedCode])
  @@index([stocktakeId])
  @@index([variantId])
}
